# DP02 Streaming Pipeline — Template de variáveis de ambiente
# Copiar para .env e preencher os valores antes de executar run_streaming_pipeline.py
#
# Obter token ENTSO-E: email para transparency@entsoe.eu, assunto "RESTful API access"
# Resposta tipicamente em ~3 dias úteis. Token gratuito.
# Sem token: usar --source energycharts (Energy-Charts/Fraunhofer ISE, sem autenticação)

# -------------------------------------------------------
# ENTSO-E — obrigatório apenas com --source entsoe
# -------------------------------------------------------
ENTSOE_TOKEN=

# -------------------------------------------------------
# Trino (valores por defeito do docker-compose)
# -------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg

# -------------------------------------------------------
# MinIO / S3 (valores por defeito do docker-compose)
# -------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# -------------------------------------------------------
# MLflow (opcional — para treino do modelo GBR)
# -------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:15000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
